{
  "name": "@repo/interpreter",
  "version": "1.0.0",
  "description": "DSL interpreter for test automation with scanner, parser, and interpreter components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --declaration && node scripts/build-bundled.cjs",
    "check-types": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "dsl",
    "interpreter",
    "test-automation",
    "parser",
    "scanner"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "esbuild": "^0.25.11",
    "typescript": "^5.7.3"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
