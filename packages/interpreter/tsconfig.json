{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Node",
		"allowImportingTsExtensions": false,
		"esModuleInterop": true,
		"isolatedModules": true,
		"declaration": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"target": "ES2023",
		"sourceMap": true,
		"outDir": "./dist",
		"baseUrl": "./",
		"rootDir": "./",
		"incremental": true,
		"skipLibCheck": true,
		"strictNullChecks": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": false,
		"strictBindCallApply": false,
		"noFallthroughCasesInSwitch": false
	},
	"include": ["index.ts", "src/scanner.ts", "src/parser.ts", "src/interpreter.ts", "src/token.ts", "src/token-type.ts", "src/expr.ts", "src/stmt.ts", "src/environment.ts", "src/parameter.ts", "src/variable.ts"],
	"exclude": ["node_modules/**"]
}
