{
  "name": "test-runner-worker",
  "version": "1.0.0",
  "description": "Playwright test runner microservice",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start:execution": "node dist/workers/execution.worker.js",
    "start:database": "node dist/workers/database.worker.js",
    "dev:execution": "tsx watch src/workers/execution.worker.ts",
    "dev:database": "tsx watch src/workers/database.worker.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@repo/interpreter": "workspace:*",
    "bullmq": "^5.58.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "ioredis": "^5.7.0",
    "minio": "^8.0.5",
    "playwright": "^1.40.0",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "nodemon": "^3.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.7.3"
  }
}
